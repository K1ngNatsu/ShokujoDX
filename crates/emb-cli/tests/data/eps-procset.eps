%%BeginProlog
%%BeginResource: procset ShopProcs 1.0 0
currentglobal true setglobal
/ShopProcs 120 dict dup begin
/bdf { bind def } bind def
/xdf { exch def } bdf
/ldf { load def } bdf
% Defines a name only if no dictionary has it.
/ndf { 1 index where { pop pop pop } { dup xcheck { bind } if def } ifelse } bdf
/level2 /languagelevel where { pop languagelevel 2 ge } { false } ifelse def
/mo /moveto ldf
/li /lineto ldf
/cv /curveto ldf
/cp /closepath ldf
/np /newpath ldf
/gs /gsave ldf
/gr /grestore ldf
/f /fill ldf
/ef /eofill ldf
/@ /stroke ldf
/lw /setlinewidth ldf
/ct { 6 array astore concat } bdf
/clp /clip ldf
/setcmykcolor where { pop /cmyk /setcmykcolor ldf } {
  /cmyk { 4 1 roll 3 { 3 index add neg 1 add dup 0 lt { pop 0 } if 3 1 roll } repeat
    setrgbcolor pop } bdf
} ifelse
/rgb /setrgbcolor ldf
/setoverprint { pop } ndf
% tint (name) c m y k spot: a spot color with its CMYK value.
/spot {
  4 array astore /_alt xdf /_name xdf
  [ /Separation _name /DeviceCMYK
    { dup _alt 0 get mul exch dup _alt 1 get mul exch dup _alt 2 get mul exch _alt 3 get mul } ]
  setcolorspace setcolor
} bdf
/pagesize { currentpagedevice /PageSize get aload pop /_ph xdf /_pw xdf } bdf
/trypagedevice { { setpagedevice } stopped { pop } if } bdf
% Points of a polygon from an array.
/poly { /_p xdf np _p 0 get _p 1 get mo
  2 2 _p length 2 sub { dup _p exch get exch 1 add _p exch get li } for cp } bdf
end
/ProcSet defineresource pop
setglobal
%%EndResource
%%EndProlog
%%BeginSetup
/ShopProcs /ProcSet findresource begin
level2 not { (This file needs LanguageLevel 2.) print flush quit } if
<< /PageSize [200 100] >> trypagedevice
{ an_undefined_operator } stopped { /recovered true def } if
